{
  "name": "zap-playwright-client",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright browser installer for the ZAP PlaywrightClient add-on",
  "scripts": {
    "install:browsers": "playwright install --with-deps",
    "install:chrome": "playwright install chrome",
    "install:chromium": "playwright install chromium",
    "install:firefox": "playwright install firefox",
    "install:webkit": "playwright install webkit",
    "doctor": "playwright doctor",
    "clean:browsers": "playwright uninstall",
    "dev": "node --import tsx scripts/dev.ts",
    "test:integration": "node --import tsx scripts/integration.ts",
    "test:photo": "node --import tsx scripts/photo.ts"
  },
  "devDependencies": {
    "@mockholm/zap-downloader": "^1.0.11",
    "@types/node": "^25.9.0",
    "glob": "^13.0.6",
    "path": "^0.12.7",
    "playwright": "1.59.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3",
    "url": "^0.11.4"
  },
  "pnpm": {
    "patchedDependencies": {
      "@mockholm/zap-downloader": "patches/@mockholm__zap-downloader.patch"
    }
  }
}
